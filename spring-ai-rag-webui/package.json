{
  "name": "spring-ai-rag-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && npm run check:alignment && npm run check:design-system && npm run check:a11y-forms && npm run check:mutation-errors && npm run check:i18n-keys && npm run check:double-submit && npm run check:destructive && npm run check:query-errors && npm run check:page-shell && npm run check:hardcoded-copy && npm run check:reduced-motion && npm run check:heading-levels && npm run check:decorative-graphics && npm run test:design-system",
    "check:alignment": "node scripts/check-alignment-policy.mjs",
    "tokens:build": "node scripts/build-design-tokens.mjs",
    "tokens:check": "node scripts/build-design-tokens.mjs --check",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:design-tokens": "npm run check:design-system",
    "check:a11y-forms": "node scripts/check-a11y-forms.mjs",
    "check:mutation-errors": "node scripts/check-mutation-errors.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:double-submit": "node scripts/check-double-submit.mjs",
    "check:destructive": "node scripts/check-destructive-confirm.mjs",
    "check:query-errors": "node scripts/check-query-errors.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:design-system": "vitest run --config vitest.design-system.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mock": "playwright test --config playwright.preview.config.ts",
    "check:page-shell": "node scripts/check-page-shell.mjs",
    "check:hardcoded-copy": "node scripts/check-hardcoded-copy.mjs",
    "check:reduced-motion": "node scripts/check-reduced-motion.mjs",
    "check:heading-levels": "node scripts/check-heading-levels.mjs",
    "check:decorative-graphics": "node scripts/check-decorative-graphics.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "axios": "^1.14.0",
    "axios-retry": "^4.5.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}

  "legacyClient": {
    "requestFixture": "legacy-client-request.json",
    "requiredRequestFields": ["message"],
    "responseFieldsClientMayIgnore": [
      "traceId",
      "sources",
      "sessionId",
      "turnId",
      "mode",
      "requestedModel",
      "resolvedModel",
      "usage",
      "finishReason",
      "metadata",
      "stepMetrics",
      "evidenceAssessment"
    ],
    "unknownAdditiveFields": "IGNORE"
  },
  "headers": {
    "trace": "X-Trace-Id",
    "failureClass": "X-RAG-Failure-Class",
    "retryAfter": "Retry-After",
    "idempotentReplay": "X-RAG-Idempotent-Replay"
  },
  "failureActions": [
    {
      "signal": "failureClass=RATE_LIMITED",
      "action": "BOUNDED_RETRY_AFTER"
    },
    {
      "signal": "failureClass=CONFLICT;error=CHAT_TURN_IN_PROGRESS",
      "action": "QUERY_OR_SAFE_REPLAY"
    },
    {
      "signal": "failureClass=DEPENDENCY_UNAVAILABLE",
      "action": "BOUNDED_RETRY_OR_DEGRADE"
    },
    {
      "signal": "failureClass=TIMEOUT",
      "action": "RETRY_ONLY_IF_SAFE_TO_REPLAY"
    },
    {
      "signal": "failureClass=CLIENT_REQUEST|AUTHENTICATION|AUTHORIZATION",
      "action": "DO_NOT_RETRY"
    },
    {
      "signal": "evidenceAssessment.status=NO_EVIDENCE|MISSING_CITATION|INVALID_CITATION|PARTIAL_CITATION|CONTEXT_LIMITED",
      "action": "SHOW_SAFE_ANSWER_AND_REQUEST_SCOPE"
    },
    {
      "signal": "error=MODEL_CAPABILITY_UNSUPPORTED",
      "action": "SELECT_COMPATIBLE_MODEL"
    },
    {
      "signal": "failureClass=NOT_FOUND|INTERNAL",
      "action": "DO_NOT_AUTORETRY_BY_DEFAULT"
    }
  ],
  "liveProbe": {
    "enabledBy": "CLIENT_CONTRACT_LIVE=1",
    "baseUrlEnv": "CLIENT_CONTRACT_BASE_URL",
    "apiKeyEnv": "CLIENT_CONTRACT_API_KEY",
    "queryEnv": "CLIENT_CONTRACT_QUERY",
    "modelEnv": "CLIENT_CONTRACT_MODEL",
    "nativeMode": "PLAIN",
    "knowledgeEvidenceRequired": false,
    "openaiDisabledIsConditionalSkip": true,
    "defaultGateCallsModel": false
  }

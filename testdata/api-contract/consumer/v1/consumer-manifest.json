    "nativeSse": "native-chat-stream.sse",
    "openaiJson": "openai-chat-completion-response.json",
    "openaiSse": "openai-chat-completion-stream.sse",
    "deprecations": "deprecations.json"
  },
  "transports": {
    "nativeJson": {
      "endpoint": "/api/v1/rag/chat",
      "method": "POST",
      "contentType": "application/json",
      "responseContentType": "application/json",
      "requiredRequestFields": ["message"],
      "requiredResponseFields": ["answer"],
      "optionalResponseFields": [
        "traceId",
        "sources",
        "sessionId",
        "turnId",
        "mode",

      "method": "POST",
      "contentType": "application/json",
      "responseContentType": "text/event-stream",
      "events": {
        "allowed": ["content", "tool_start", "tool_result", "sources", "done", "error"],
        "successTerminal": "done",
        "errorTerminal": "error",
        "sourcesBeforeDone": true,
        "sequence": "MONOTONIC_IGNORE_DUPLICATES",
        "heartbeatComments": true,
        "eofTailBlock": true,
        "multiLineData": true,
        "lineEndings": ["LF", "CRLF"]
      }
    },
    "openaiJson": {
      "endpoint": "/v1/chat/completions",
      "method": "POST",
      "contentType": "application/json",
      "responseContentType": "application/json",
      "requiredRequestFields": ["model", "messages"],
      "requiredResponseFields": ["id", "object", "created", "model", "choices"],
      "privateResponseFields": [
        "answer",
        "sources",
        "evidenceAssessment",
        "traceId",
        "failureClass",
        "metadata"
      ],
      "responseExtensions": {
        "rag": {
          "fields": {
            "traceId": "string",
            "evidenceAssessment": "object",
            "sources": "array",
            "citationRegistry": "object",
            "collectionCoverage": "object",
            "modelSafetyRefusal": "boolean",
            "answerOutcome": "object"
          },
          "nestedFields": {
            "answerOutcome": ["status", "reasonCode"],
            "evidenceAssessment": [
              "status", "retrievalExecuted", "sourceCount", "citedSourceCount",
              "invalidCitationIds", "contextLimited", "safeAnswerApplied", "reasonCode"
            ],
            "sources": [
              "citationId", "sourceHandle", "documentId", "chunkIndex", "title",
              "score", "vectorScore", "fulltextScore", "originalFilename",
              "documentType", "collectionKey", "sourceType", "evidenceSnapshot"
            ],
            "citationRegistry": ["version", "handlePrefix", "sourceCount", "handles"],
            "collectionCoverage": [
              "mode", "requestedCollectionIds", "requestedCount", "returnedCount",
              "missingCount", "missingCollectionIds", "incompleteCount",
              "incompleteCollectionIds", "degraded", "collectionBranchStatuses",
              "perCollectionResultCounts"
            ]
          }
        }
      }
    },
    "openaiSse": {
      "endpoint": "/v1/chat/completions",
      "method": "POST",
      "contentType": "application/json",
      "responseContentType": "text/event-stream",
      "requiredRequestFields": ["model", "messages", "stream"],
      "terminalMarker": "[DONE]",
      "privateResponseFields": [
        "answer",
        "sources",
        "evidenceAssessment",
        "traceId",
        "failureClass",
        "metadata"
      ],
      "responseExtensions": {
        "rag": {
          "fields": {
            "traceId": "string",
            "evidenceAssessment": "object",
            "sources": "array",
            "citationRegistry": "object",
            "collectionCoverage": "object",
            "modelSafetyRefusal": "boolean",
            "answerOutcome": "object"
          },
          "nestedFields": {
            "answerOutcome": ["status", "reasonCode"],
            "evidenceAssessment": [
              "status", "retrievalExecuted", "sourceCount", "citedSourceCount",
              "invalidCitationIds", "contextLimited", "safeAnswerApplied", "reasonCode"
            ],
            "sources": [
              "citationId", "sourceHandle", "documentId", "chunkIndex", "title",
              "score", "vectorScore", "fulltextScore", "originalFilename",
              "documentType", "collectionKey", "sourceType", "evidenceSnapshot"
            ],
            "citationRegistry": ["version", "handlePrefix", "sourceCount", "handles"],
            "collectionCoverage": [
              "mode", "requestedCollectionIds", "requestedCount", "returnedCount",
              "missingCount", "missingCollectionIds", "incompleteCount",
              "incompleteCollectionIds", "degraded", "collectionBranchStatuses",
              "perCollectionResultCounts"
            ]
          }
        }
      }
    }

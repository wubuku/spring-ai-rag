{
  "contractName": "spring-ai-rag-client-consumer",
  "contractVersion": 1,
  "fixtureVersion": "1.0.0",
  "compatibilityMode": "ADDITIVE_ONLY",
  "producerManifest": "../../v1-compatibility.json",
  "openapiSurface": "openapi-surface.json",

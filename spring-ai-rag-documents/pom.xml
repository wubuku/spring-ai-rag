<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.springairag</groupId>
        <artifactId>spring-ai-rag</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>spring-ai-rag-documents</artifactId>
    <name>Spring AI RAG - Documents</name>
    <description>Document processing components (parsers, chunking strategies, text cleaning)</description>

    <dependencies>
        <!-- 本模块只依赖 JDK；解析/分块组件不引用 Spring 或本项目其他模块。
             原先声明的 api、spring-ai-model、spring-boot-starter 均未被源码使用
             （mvn dependency:analyze 判定为 Unused declared）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

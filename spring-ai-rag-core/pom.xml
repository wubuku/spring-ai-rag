<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.springairag</groupId>
        <artifactId>spring-ai-rag</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>spring-ai-rag-core</artifactId>
    <name>Spring AI RAG - Core</name>
    <description>General-purpose RAG service core implementation (Advisors, retrieval, chunking, memory, model config)</description>

    <dependencies>
        <!-- Project API module -->
        <dependency>
            <groupId>com.springairag</groupId>
            <artifactId>spring-ai-rag-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Project Documents module (chunkers, text cleaning) -->
        <dependency>
            <groupId>com.springairag</groupId>
            <artifactId>spring-ai-rag-documents</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Pinned DNS resolution for server-owned allowlisted HTTP tools -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- Bean Validation（@NotBlank / @NotNull / @Valid） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 版本由根 pom 的 dependencyManagement 统一管理（必须跟随 hibernate.version） -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-vector</artifactId>
        </dependency>

        <!-- Spring AI OpenAI library (no auto-config, manually managed by SpringAiConfig) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- Spring AI Anthropic (optional, uncomment when needed) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI MiniMax (optional, supports MiniMax series models) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-minimax</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI Chat Memory JDBC Starter -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <!-- Spring AI Advisors Vector Store (includes VectorStoreChatMemoryAdvisor) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!-- Spring AI Modular RAG -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- 显式声明与 springdoc 2.8.17 的 swagger-core 2.2.47 对齐；版本号由根 pom
             的 swagger-api.version 统一管理（注解与 core 不同版本会在 /v3/api-docs
             运行期抛 NoSuchMethodError）。 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (metrics + health checks) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Retry: declarative retry with exponential backoff -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <!-- Caffeine local cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Spring Boot Cache (@Cacheable / @CacheEvict support) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Spring Mail: email notifications via SMTP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL (real database for integration tests) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Testcontainers (@ServiceConnection auto-configuration) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Logstash Logback Encoder: JSON structured logs + sensitive data masking -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- OpenAPI Contract Testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Markdown → HTML rendering (replaces hand-rolled regex) -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
        </dependency>

        <!--
          HTML sanitisation for rendered Markdown previews.
          commonmark-java passes raw HTML in the Markdown source straight through,
          and every preview is served on this application's own origin, so the
          rendered fragment is cleaned against an allow-list before it is returned.
        -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- YAML frontmatter for server-owned runtime Skills -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- PDF text extraction (pure Java, replaces external marker CLI) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Core is a library module: do NOT add spring-boot-maven-plugin, otherwise it creates a fat JAR that other modules cannot depend on -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Mutation profile（默认关闭，不参与日常 mvn test）：
            对少数关键判定类跑 PIT mutation testing，用来发现“测试假绿”。
            用法：
              JAVA_HOME=<jdk21> mvn -pl spring-ai-rag-core -am -Pmutation \
                test-compile org.pitest:pitest-maven:mutationCoverage
            报告：spring-ai-rag-core/target/pit-reports/
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.2</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- 只变异关键判定类；其余包由普通单测覆盖，不纳入变异范围。 -->
                            <targetClasses>
                                <param>com.springairag.core.retrieval.RetrievalScope*</param>
                                <param>com.springairag.core.retrieval.RerankResultSelector</param>
                                <param>com.springairag.core.retrieval.EmbeddingFailureClassifier</param>
                                <param>com.springairag.core.ratelimit.PostgresRateLimitStore</param>
                                <param>com.springairag.core.chat.ChatSessionCoordinator</param>
                                <param>com.springairag.core.chat.ChatExecutionBudget</param>
                                <param>com.springairag.core.service.DocumentLifecycleService</param>
                                <param>com.springairag.core.resilience.UpstreamFailureClassifier</param>
                                <param>com.springairag.core.filter.FailureClassHttpSupport</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.springairag.core.retrieval.RetrievalScope*Test</param>
                                <param>com.springairag.core.retrieval.RerankResultSelectorTest</param>
                                <param>com.springairag.core.retrieval.EmbeddingFailureClassifierTest</param>
                                <param>com.springairag.core.ratelimit.*Test</param>
                                <param>com.springairag.core.chat.ChatSessionCoordinator*Test</param>
                                <param>com.springairag.core.chat.ChatExecutionBudget*Test</param>
                                <param>com.springairag.core.service.DocumentLifecycle*Test</param>
                                <param>com.springairag.core.resilience.UpstreamFailureClassifierTest</param>
                                <param>com.springairag.core.filter.FailureClass*Test</param>
                            </targetTests>
                            <threads>4</threads>
                            <outputFormats>
                                <outputFormat>XML</outputFormat>
                                <outputFormat>HTML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>0</mutationThreshold>
                            <coverageThreshold>0</coverageThreshold>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <verbose>false</verbose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            WebUI profile: builds the spring-ai-rag-webui frontend
            and copies dist/ to spring-ai-rag-core/src/main/resources/static/webui/
            Usage: mvn spring-boot:run -Pwebui
                  or: mvn package -pl spring-ai-rag-core -Pwebui
        -->
        <profile>
            <id>webui</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>build-webui</id>
                                <goals><goal>exec</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <workingDirectory>${project.basedir}/../spring-ai-rag-webui</workingDirectory>
                                    <executable>npm</executable>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>clean-webui-static</id>
                                <goals><goal>clean</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.basedir}/src/main/resources/static/webui/assets</directory>
                                            <includes>
                                                <include>**/*</include>
                                            </includes>
                                        </fileset>
                                        <fileset>
                                            <directory>${project.basedir}/src/main/resources/static/webui</directory>
                                            <excludes>
                                                <exclude>assets/**</exclude>
                                            </excludes>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-webui</id>
                                <goals><goal>copy-resources</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <outputDirectory>${project.basedir}/src/main/resources/static/webui</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../spring-ai-rag-webui/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

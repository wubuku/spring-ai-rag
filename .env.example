# ============================================
# Spring AI RAG Environment Variables Template
# Copy to .env and fill in real values
# ============================================
#
# 每一个写在下面（未注释）的变量都必须有代码或脚本真的读它。
# `node scripts/verify-env-example-consumers.mjs` 强制这一点，理由是实测过的：
# `ad026765` 以「补齐所有现存配置项」的名义写进了 6 个变量
# （TRANSCRIPTION_* / VISION_*），而对应的代码从来没有存在过——
# Spring AI 的依赖树里没有 transcription / vision 的 autoconfigure 模块，
# `docs/openai-compatibility-readiness.md` 也明写多模态输入不支持。
# 模板承诺一个没人读的旋钮，等于承诺一个改了不会有任何变化的开关。
#
# 加新变量之前先确认有消费者；确认不了就别加。
# 已注释的行是「可用开关」的说明，不受这道门禁约束，见门禁头部。

# ══════════════════════════════════════════════════════════
# PostgreSQL Database Configuration
# ══════════════════════════════════════════════════════════
POSTGRES_DATABASE=spring_ai_rag_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# Spring Boot datasource URL (optional, takes precedence over individual host/port/db)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spring_ai_rag_dev
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ══════════════════════════════════════════════════════════
# LLM Provider Selection (3 modes)
# ══════════════════════════════════════════════════════════
# Values:
#   openai     — OpenAI API compatible models (DeepSeek / Zhipu / SiliconFlow etc.)
#   anthropic  — Anthropic API compatible models (VolcEngine ARK MiniMax etc.)
#   minimax    — Spring AI native MiniMax starter
LLM_PROVIDER=openai

# ══════════════════════════════════════════════════════════
# OpenAI API Compatible Model (used when LLM_PROVIDER=openai)
# Applicable to: DeepSeek, Zhipu, SiliconFlow (International) etc.
# ══════════════════════════════════════════════════════════
#
# IMPORTANT: base-url must NOT include /v1 suffix!
# Spring AI's OpenAiApi automatically appends /v1/chat/completions
# If base-url contains /v1, the final URL becomes /v1/v1/... → 401/404
# Reference: https://github.com/spring-projects/spring-ai/issues/710
SPRING_AI_OPENAI_API_KEY=sk-your-openai-compatible-key
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.7

# SiliconFlow OpenAI Compatible Configuration (example)
# SPRING_AI_OPENAI_API_KEY=sk-your-siliconflow-key
# SPRING_AI_OPENAI_BASE_URL=https://api.siliconflow.cn
# SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=Qwen/Qwen2.5-7B-Instruct

# ══════════════════════════════════════════════════════════
# Anthropic API Compatible Model (used when LLM_PROVIDER=anthropic)
# Applicable to: VolcEngine ARK MiniMax etc.
# ══════════════════════════════════════════════════════════
# IMPORTANT: base-url must NOT include /v1 suffix!
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# ══════════════════════════════════════════════════════════
# Spring AI Native MiniMax Support (used when LLM_PROVIDER=minimax)
# Requires spring-ai-starter-model-minimax dependency
# API Key: https://platform.minimax.com
# ══════════════════════════════════════════════════════════
# IMPORTANT: base-url must NOT include /v1 suffix!
SPRING_AI_MINIMAX_API_KEY=sk-your-minimax-key
SPRING_AI_MINIMAX_BASE_URL=https://api.minimaxi.com
SPRING_AI_MINIMAX_CHAT_OPTIONS_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=sk-your-minimax-key
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TEMPERATURE=0.7

# ══════════════════════════════════════════════════════════
# Embedding Model Configuration (provider-neutral names)
# Used for: vector retrieval and hybrid search.
# The default provider is SiliconFlow, but the variable names describe the
# embedding role rather than a particular model vendor.
# ══════════════════════════════════════════════════════════
# IMPORTANT: URL must NOT include /v1 path!
# Spring AI's OpenAiEmbeddingModel automatically appends /v1/embeddings
# If configured with /v1, final URL becomes https://api.siliconflow.cn/v1/embeddings → 404!
# Correct: https://api.siliconflow.cn
# Wrong:   https://api.siliconflow.cn/v1 ❌
RAG_EMBEDDING_API_KEY=sk-your-embedding-provider-key
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
# Startup check: error (default) refuses an incomplete local configuration.
# Set warn only for an explicit diagnostic startup; it never injects a mock
# embedding model or placeholder credential.
# RAG_EMBEDDING_STARTUP_CHECK=error
# Per-provider-call retry attempts; separate from durable job attempts. Range: 1-10.
RAG_EMBEDDING_RETRY_MAX_ATTEMPTS=10
RAG_EMBEDDING_PROFILE_KEY=siliconflow-bge-m3-1024-v1
RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL_REVISION=unspecified
# Only set migration variables for an explicitly planned Legacy adoption.
# RAG_EMBEDDING_MIGRATION_MODE=adopt-legacy
# RAG_EMBEDDING_MIGRATION_LEGACY_PROFILE_KEY=siliconflow-bge-m3-1024-v1
# RAG_EMBEDDING_MIGRATION_CONFIRM=I_HAVE_VERIFIED_THE_LEGACY_MODEL

# Persistent embedding/reindex jobs are opt-in. Existing synchronous embed APIs
# remain available while this worker is disabled.
RAG_EMBEDDING_JOBS_ENABLED=false
# RAG_EMBEDDING_JOBS_POLL_INTERVAL_MS=1000
# RAG_EMBEDDING_JOBS_CLAIM_BATCH_SIZE=4
# RAG_EMBEDDING_JOBS_LEASE_SECONDS=120
# RAG_EMBEDDING_JOBS_DEFAULT_MAX_ATTEMPTS=3
# RAG_EMBEDDING_JOBS_MAX_ATTEMPTS=5
# RAG_EMBEDDING_JOBS_RETRY_BACKOFF_SECONDS=10

# Controlled OpenAI Chat Completions server adapter. Model aliases are defined
# in application.yml; Collection scope remains request-specific.
RAG_OPENAI_COMPATIBILITY_ENABLED=false
RAG_OPENAI_REQUIRE_EXPLICIT_SCOPE=false

# Optional Spring AI Agent tool for JSONB structured-record retrieval.
RAG_JSON_AGENT_TOOL_ENABLED=false

# JSON structured-record runtime limits. These values are published through
# /api/v1/rag/integration-capabilities for client-side batch planning.
# RAG_STRUCTURED_RECORDS_MAX_JSONB_PAYLOAD_BYTES=1048576
# RAG_STRUCTURED_RECORDS_MAX_RETRIEVAL_TEXT_CHARS=10000
# RAG_STRUCTURED_RECORDS_MAX_BATCH_SIZE=20
# RAG_STRUCTURED_RECORDS_MAX_BATCH_PAYLOAD_BYTES=10485760
# RAG_STRUCTURED_RECORDS_MAX_SEARCH_RESULTS=20
# RAG_STRUCTURED_RECORDS_MAX_PAYLOAD_FILTER_BYTES=16384
# RAG_STRUCTURED_RECORDS_MAX_PAYLOAD_FILTER_DEPTH=8

# Best-effort, principal/Collection-scoped integration operation rollups.
# Recording is asynchronous and fail-open for business requests.
RAG_INTEGRATION_OBSERVABILITY_ENABLED=true
# RAG_INTEGRATION_OBSERVABILITY_RETENTION=90d
# RAG_INTEGRATION_OBSERVABILITY_MAX_QUERY_RANGE=31d
# RAG_INTEGRATION_OBSERVABILITY_MAX_COLLECTION_BREAKDOWN_ITEMS=100
# RAG_INTEGRATION_OBSERVABILITY_QUEUE_CAPACITY=10000
# RAG_INTEGRATION_OBSERVABILITY_FLUSH_BATCH_SIZE=500
# RAG_INTEGRATION_OBSERVABILITY_FLUSH_INTERVAL=1s
# RAG_INTEGRATION_OBSERVABILITY_SHUTDOWN_DRAIN_TIMEOUT=5s
# RAG_INTEGRATION_OBSERVABILITY_CLEANUP_BATCH_SIZE=5000
# RAG_INTEGRATION_OBSERVABILITY_CLEANUP_INTERVAL=1h

# ══════════════════════════════════════════════════════════
# Application Configuration
# ══════════════════════════════════════════════════════════
# Application port (default 8081)
APP_PORT=8081

# Spring profiles (optional)
# SPRING_PROFILES_ACTIVE=postgresql

# ══════════════════════════════════════════════════════════
# 设置 RAG Root API Key（至少 32 个可打印 ASCII 字符）
# 生成一个高熵值：
# openssl rand -hex 32
# RAG_ROOT_API_KEY=<使用上方命令生成的值>

# API credential staged rotation (optional)
# RAG_API_KEY_ROTATION_DEFAULT_OVERLAP=15m
# RAG_API_KEY_ROTATION_MAX_OVERLAP=1h
# RAG_API_KEY_ROTATION_OPERATION_RETENTION=400d
# RAG_API_KEY_ROTATION_CLEANUP_INTERVAL_MS=60000
# RAG_API_KEY_ROTATION_CLEANUP_BATCH_SIZE=500
